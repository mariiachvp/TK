# Copiar este archivo a .env y completar los valores reales
# .env NO debe subirse a git nunca

# Obligatorio en producción
DJANGO_SECRET_KEY=genera-una-clave-segura-con-python-secrets

# "True" solo en desarrollo local
DJANGO_DEBUG=False

# Separar múltiples hosts por coma
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# Base de datos (producción)
DB_NAME=lascargo_tickets
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Nivel de log: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO

# Microsoft Graph API (Fase 3)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=it-helpdesk@lascargo.com
IT_TEAM_EMAIL=it@lascargo.com
